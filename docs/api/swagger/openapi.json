{
  "openapi": "3.0.0",
  "info": {
    "description": "This is an API documentation for TiGrow LTD",
    "version": "1.0.0-oas3",
    "title": "TiGrow LTD API",
    "contact": {
      "email": "alamariful1727@gmail.com"
    },
    "license": {
      "name": "Apache 2.0",
      "url": "http://www.apache.org/licenses/LICENSE-2.0.html"
    }
  },

  "tags": [
    {
      "name": "admins",
      "description": "Secured Admin-only calls"
    },
    {
      "name": "product",
      "description": ""
    },
    {
      "name": "User Auth",
      "description": ""
    }
  ],

  "paths": {
    "/account/signup": {
      "post": {
        "description": "Account signup",
        "summary": "Create a new account",
        "security": [
          {
            "JWT": []
          }
        ],
        "requestBody": {
          "description": "Optional description in *Markdown*",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignupRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          }
        }
      }
    },
    "/account/login": {
      "post": {
        "tags": ["User Auth"],
        "summary": "Login information about account",
        "requestBody": {
          "description": "Optional description in *Markdown*",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/loginRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "loggedin"
          }
        }
      }
    },
    "/company": {
      "post": {
        "description": "Send company info to the account",
        "security": [
          {
            "JWT": []
          }
        ],
        "requestBody": {
          "description": "Required fields: name, type, address",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/createCompanyRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/createCompanyResponse"
                }
              }
            }
          },
          "401": {
            "description": "You don't have permissions for the resource"
          }
        }
      }
    },

    "/category": {
      "get": {
        "tags": ["product"],
        "summary": "searches category",
        "operationId": "searchInventory",
        "description": "By passing in the appropriate options, you can search for\navailable category in the system\n",
        "parameters": [
          {
            "in": "query",
            "name": "type",
            "description": "pass category option",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["job-seeker", "emp", "business", "company"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "search results matching 'type'",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Category"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Expects 'type' in query string"
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "http://192.168.8.252:4044/api/v1",
      "description": "Development server"
    },
    {
      "url": "http://localhost:4040/api/v1",
      "description": "Local server"
    }
  ],
  "components": {
    "securitySchemes": {
      "JWT": {
        "type": "apiKey",
        "name": "Authorization",
        "in": "header"
      }
    },
    "schemas": {
      "createCompanyRequest": {
        "type": "object",
        "required": ["name", "type", "address"],
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "Manufacturer",
              "Trading Company",
              "Buying Office",
              "Agent",
              "Distributor/Wholesaler",
              "Government ministry/Bureau/Commission",
              "Association",
              "Business Service (Transportation, finance, travel, Ads, etc)",
              "Other"
            ]
          },
          "address": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "legalOwnerName": {
            "type": "string"
          },
          "legalOwnerMail": {
            "type": "string"
          }
        }
      },
      "createCompanyResponse": {
        "type": "object",
        "properties": {
          "_id": {
            "example": "5cf367d2c8ec086b7c98a52f"
          },
          "name": {
            "example": "TiGrow"
          },
          "type": {
            "example": "Manufacturer"
          },
          "address": {
            "example": "Mohakhali"
          },
          "email": {
            "example": "test@tigrow.co"
          },
          "legalOwnerName": {
            "example": "test name"
          },
          "legalOwnerMail": {
            "example": "test@gmail.com"
          },
          "role": {
            "default": "superAdmin"
          }
        }
      },

      "loginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": {
            "type": "string",
            "example": "o@o.com"
          },
          "password": {
            "type": "string",
            "example": "Rob@t124309"
          }
        }
      },

      "SignupRequest": {
        "type": "object",
        "required": [
          "firstName",
          "lastName",
          "contactNo",
          "email",
          "password",
          "confirmPassword"
      }],
        "properties": {
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "contactNo": {
            "type": "number"
          },
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "confirmPassword": {
            "type": "string"
          }
        }
      },
      "SignupResponse": {
        "type": "object",
        "properties": {
          "success": true,
          "message": "User created",
          "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpYXQiOjE1NzI1MjQ4MTUsImV4cCI6MTU3NzcwODgxNX0.OYArAZ42-weX1P2s68L6OcdOSpFVnLVygj1iT7N6j8M",
          "infoObj": {
            "accountType": "normal",
            "accountVerified": false,
            "skillArea": [],
            "friends": [],
            "pendingFriends": [],
            "sendingFriendList": [],
            "jobExperience": [],
            "education": [],
            "_id": "5dbad30f4834fa2fb5542efb",
            "email": "robatdas2018@gmail.com",
            "firstName": "orvi",
            "lastName": "das",
            "name": "orviaQEZWGqS",
            "contactNo": "8801683754716",
            "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpYXQiOjE1NzI1MjQ4MTUsImV4cCI6MTU3NzcwODgxNX0.OYArAZ42-weX1P2s68L6OcdOSpFVnLVygj1iT7N6j8M",
            "__v": 0
          }
        }
      },

      "Company": {
        "type": "object",
        "properties": {
          "companyName": {
            "type": "string",
            "example": "face@fb.com"
          },
          "phoneNumber": {
            "type": "string",
            "example": "8801673754716"
          },
          "companyAddress": {
            "type": "string",
            "example": "mohkhali dohs"
          },
          "establishDate": {
            "type": "string",
            "example": "2019"
          },
          "selectDistrict": {
            "type": "string",
            "example": "Dhaka"
          },
          "selectThana": {
            "type": "string",
            "example": "banani"
          },
          "businessDescription": {
            "type": "string",
            "example": "Social network site"
          },
          "tradelicense": {
            "type": "string",
            "example": "10000000"
          },
          "contactPersonName": {
            "type": "string",
            "example": "orvi"
          },
          "contactPersonDesignation": {
            "type": "string",
            "example": "software engineer"
          },
          "contactPersonemail": {
            "type": "string",
            "example": "das.orvi@yahoo.com"
          },
          "contactPersonMobile": {
            "type": "string",
            "example": "8801683754716"
          }
        }
      },
      "Category": {
        "type": "object",
        "required": ["name", "type"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{24}$",
            "example": "5cf367d2c8ec086b7c98a52f"
          },
          "name": {
            "type": "string",
            "example": "Field of Expertise",
            "default": "sad"
          },
          "type": {
            "type": "string",
            "enum": ["job-seeker", "emp", "business", "company"],
            "example": "job-seeker"
          },
          "subcategories": {
            "$ref": "#/components/schemas/SubCategory"
          }
        }
      },
      "SubCategory": {
        "required": ["cid", "name"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{24}$",
            "example": "5cf367d2c8ec086b7c98a52f"
          },
          "cid": {
            "$ref": "#/components/schemas/Category"
          },
          "name": {
            "type": "string",
            "example": "Engineering & Computer Science"
          },
          "subcategories": {
            "$ref": "#/components/schemas/SubSubCategory"
          }
        }
      },
      "SubSubCategory": {
        "required": ["cid", "name"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{24}$",
            "example": "5cf367d2c8ec086b7c98a52f"
          },
          "cid": {
            "$ref": "#/components/schemas/Category"
          },
          "name": {
            "type": "string",
            "example": "Engineering & Computer Science"
          },
          "subcategories": {
            "$ref": "#/components/schemas/SubSubCategory"
          }
        }
      }
    }
  }
}
