{
  "name": "tigrow",
  "version": "2.0.0",
  "description": "A comunity for business people",
  "author": "rubyat farhan <tigrowtecheven@gmail.com>",
  "main": "index.js",
  "private": true,
  "engines": {
    "node": ">=8.10.0",
    "npm": ">=5.6.0",
    "yarn": ">=1.5.1"
  },
  "scripts": {
    "start": "nodemon node index.js",
    "start:debug": "cross-env DEBUG=express-mongoose-es6-rest-api:* yarn start",
    "start:prod": "export NODE_ENV=production && pm2 start index.js",
    "lint": "esw *.js server config --color",
    "lint:watch": "yarn lint -- --watch",
    "test": "cross-env NODE_ENV=test mocha ./server/**/*.test.js  --ui bdd --reporter spec --colors server --recursive --timeout 40000 --exit",
    "test:watch": "yarn test -- --watch",
    "test:coverage": "cross-env NODE_ENV=test ./node_modules/.bin/istanbul cover _mocha -- --ui bdd --reporter spec --colors server --recursive",
    "test:check-coverage": "yarn test:coverage && istanbul check-coverage",
    "report-coverage": "coveralls < ./coverage/lcov.info"
  },
  "repository": {
    "type": "git",
    "url": "git@bitbucket.org:BirUdaya/tigrowback.git"
  },
  "keywords": [
    "server",
    "REST",
    "API",
    "backend"
  ],
  "dependencies": {
    "@hapi/joi": "^15.1.1",
    "@slack/web-api": "^5.2.1",
    "@slack/webhook": "^5.0.2",
    "aws-sdk": "^2.538.0",
    "axios": "^0.19.0",
    "bcrypt": "^3.0.8",
    "bluebird": "^3.5.5",
    "body-parser": "^1.19.0",
    "chalk": "^3.0.0",
    "compression": "1.7.4",
    "concurrently": "^3.6.1",
    "connect-mongo": "^3.0.0",
    "cookie-parser": "1.4.4",
    "cors": "2.8.5",
    "debug": "^4.1.1",
    "dotenv": "^8.0.0",
    "elastic-apm-node": "^3.3.0",
    "elasticsearch": "^16.6.0",
    "express": "4.17.1",
    "express-jwt": "^5.3.1",
    "express-session": "^1.16.2",
    "express-validation": "1.0.2",
    "express-winston": "3.2.1",
    "firebase-admin": "^8.2.0",
    "helmet": "^3.21.1",
    "http-status": "1.3.2",
    "jshint": "^2.10.2",
    "jsonwebtoken": "^8.5.1",
    "jwt-simple": "^0.5.6",
    "loadash": "^1.0.0",
    "loadtest": "^3.0.7",
    "lodash": "^4.17.15",
    "method-override": "^3.0.0",
    "mongoose": "^5.6.4",
    "mongoose-timestamp": "^0.6.0",
    "morgan": "1.9.1",
    "ms": "^2.1.2",
    "multer": "^1.4.2",
    "nodemailer": "^6.3.0",
    "nodemailer-smtp-transport": "^2.7.4",
    "nodemon": "^1.19.1",
    "passport": "^0.4.0",
    "passport-facebook": "^3.0.0",
    "passport-google-oauth": "^2.0.0",
    "passport-jwt": "^4.0.0",
    "passport-local": "^1.0.0",
    "passport-oauth": "^1.0.0",
    "pusher": "^3.0.1",
    "rand-token": "^0.4.0",
    "react-router-dom": "^4.3.1",
    "redis": "^2.8.0",
    "redis-clustr": "^1.7.0",
    "rotating-file-stream": "^1.4.4",
    "semver": "^6.2.0",
    "set-immediate-shim": "^2.0.0",
    "shortid": "^2.2.15",
    "slug": "^2.1.1",
    "winston": "3.2.1"
  },
  "devDependencies": {
    "chai": "4.2.0",
    "commitizen": "^4.0.3",
    "coveralls": "^3.0.5",
    "cross-env": "5.2.0",
    "cz-conventional-changelog": "2.1.0",
    "eslint": "^6.2.2",
    "eslint-config-airbnb-base": "13.2.0",
    "eslint-config-prettier": "^6.1.0",
    "eslint-plugin-import": "2.18.0",
    "eslint-watch": "^5.1.2",
    "husky": "^3.0.0",
    "istanbul": "1.1.0-alpha.1",
    "mocha": "^6.1.4",
    "nyc": "^15.0.0",
    "should": "^13.2.3",
    "supertest": "4.0.2",
    "supertest-as-promised": "4.0.2",
    "validate-commit-msg": "^2.14.0"
  },
  "license": "MIT",
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
