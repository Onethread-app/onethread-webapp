{
  "name": "onethread",
  "version": "2.4.12",
  "description": "Efficiency for everyone",
  "author": "Robat Das Orvi (orvi@onethread.app)",
  "main": "index.js",
  "private": true,
  "engines": {
    "node": ">=8.10.0",
    "npm": ">=5.6.0",
    "yarn": ">=1.5.1"
  },
  "scripts": {
    "start": "nodemon node index.js",
    "start:debug": "cross-env DEBUG=express-mongoose-es6-rest-api:* yarn start",
    "start:prod": "export NODE_ENV=production && pm2 start index.js",
    "lint": "esw *.js server config --color",
    "lint:watch": "node lint -- --watch",
    "test": "jest test --runInBand --detectOpenHandles --forceExit",
    "test:watch": "yarn test -- --watch",
    "test:coverage": "jest --coverage",
    "test:check-coverage": "yarn test:coverage && istanbul check-coverage",
    "report-coverage": "coveralls < ./coverage/lcov.info"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Onethread-app/onethread-webapp"
  },
  "keywords": [
    "server",
    "REST",
    "API",
    "backend"
  ],
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged && pretty-quick --staged"
    }
  },
  "lint-staged": {
    "*.js": "eslint \"**/*.js\" --max-warnings=0"
  },
  "dependencies": {
    "@hapi/joi": "^15.1.1",
    "aws-sdk": "^2.538.0",
    "axios": "^0.21.1",
    "bcrypt": "^5.0.1",
    "bluebird": "^3.5.5",
    "body-parser": "^1.19.0",
    "chalk": "^3.0.0",
    "compression": "1.7.4",
    "concurrently": "^3.6.1",
    "connect-mongo": "^3.0.0",
    "cookie-parser": "1.4.5",
    "cors": "2.8.5",
    "debug": "^4.1.1",
    "dotenv": "^8.0.0",
    "elastic-apm-node": "^3.3.0",
    "elasticsearch": "^16.6.0",
    "express": "4.17.1",
    "express-jwt": "^5.3.1",
    "express-session": "^1.16.2",
    "express-validation": "^3.0.2",
    "express-winston": "3.4.0",
    "firebase-admin": "^9.11.1",
    "helmet": "^3.21.1",
    "http-status": "1.5.0",
    "jshint": "^2.10.2",
    "jsonwebtoken": "^8.5.1",
    "jwt-simple": "^0.5.6",
    "loadash": "^1.0.0",
    "loadtest": "^3.0.7",
    "lodash": "^4.17.15",
    "method-override": "^3.0.0",
    "mongoose": "^5.6.4",
    "mongoose-timestamp": "^0.6.0",
    "morgan": "1.10.0",
    "ms": "^2.1.2",
    "multer": "^1.4.2",
    "node-sass": "^6.0.0",
    "nodemailer": "^6.3.0",
    "nodemailer-express-handlebars": "^4.0.0",
    "nodemailer-smtp-transport": "^2.7.4",
    "nodemon": "^2.0.4",
    "passport": "^0.4.0",
    "passport-facebook": "^3.0.0",
    "passport-google-oauth": "^2.0.0",
    "passport-jwt": "^4.0.0",
    "passport-local": "^1.0.0",
    "passport-oauth": "^1.0.0",
    "pusher": "^5.0.0",
    "qs": "^6.9.4",
    "rand-token": "^0.4.0",
    "react-router-dom": "^4.3.1",
    "redis": "^3.1.2",
    "redis-clustr": "^1.7.0",
    "rotating-file-stream": "^1.4.4",
    "semver": "^6.2.0",
    "set-immediate-shim": "^2.0.0",
    "shortid": "^2.2.15",
    "slug": "^2.1.1",
    "stripe": "^8.64.0",
    "web-push": "^3.4.4",
    "winston": "3.3.3"
  },
  "devDependencies": {
    "@shelf/jest-mongodb": "^1.2.2",
    "chai": "4.2.0",
    "commitizen": "^4.0.3",
    "coveralls": "^3.0.5",
    "cross-env": "5.2.0",
    "cz-conventional-changelog": "2.1.0",
    "eslint": "^7.32.0",
    "eslint-config-airbnb-base": "^14.2.1",
    "eslint-config-prettier": "^6.15.0",
    "eslint-plugin-import": "^2.24.2",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-watch": "^7.0.0",
    "husky": "^3.0.0",
    "i": "^0.3.6",
    "istanbul": "1.1.0-alpha.1",
    "jest": "^26.2.2",
    "jscpd": "^3.3.26",
    "lint-staged": "^11.1.2",
    "mocha": "^6.1.4",
    "npm": "^7.24.0",
    "nyc": "^15.0.0",
    "prettier": "^2.4.1",
    "pretty-quick": "^3.1.1",
    "redis-mock": "^0.50.0",
    "should": "^13.2.3",
    "supertest": "4.0.2",
    "supertest-as-promised": "4.0.2",
    "validate-commit-msg": "^2.14.0"
  },
  "license": "MIT",
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
